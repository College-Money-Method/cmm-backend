# Supabase (local dev: use local Supabase URL and anon key; testing DB = cmm_dev)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-local-anon-key
# Use for scripts that need to bypass RLS (e.g. import_schools_csv). Get from: supabase status
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_NAME=cmm_dev

# Airtable (for airtable_schema_to_postgres.py)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Optional: direct Postgres URL for applying generated schema (Supabase -> Database -> Connection string)
# DATABASE_URL=postgresql://postgres:password@host:54322/postgres

# AWS S3 (optional for local dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# CloudFront CDN for serving S3 assets. When set, asset URLs in API responses
# are rewritten from the raw S3 host to this CDN host at read time. Leave empty
# for local dev to serve assets directly from S3 (kill-switch).
# Prod value: https://cdn.next.collegemoneymethod.com
CDN_BASE_URL=

# AWS Bedrock — translation pipeline (translate-on-demand)
# Uses the classic AnthropicBedrock (InvokeModel) client; the IAM principal
# needs bedrock:InvokeModel + InvokeModelWithResponseStream (AmazonBedrockFullAccess covers it).
# BEDROCK_REGION defaults to AWS_REGION if not set.
BEDROCK_REGION=us-east-1
# Claude Haiku cross-region INFERENCE-PROFILE id (bare model ids are rejected).
# "us." = US-region routing; swap to "global.anthropic.claude-haiku-4-5-20251001-v1:0" for worldwide.
BEDROCK_HAIKU_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Zoom (Server-to-Server OAuth — required for webinar registrations)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# App
LOG_LEVEL=INFO
DEBUG=true
ENVIRONMENT=development
# Origin every link in outgoing email is built from. There is no request object
# at send time, so this is the ONLY source of the host — leave it unset and the
# code falls back to the live site, which sends local/dev mail to production
# links. Prod value: https://collegemoneymethod.com
APP_PUBLIC_URL=http://localhost:5173

# Vimeo API (personal access token, scopes: public private edit upload delete)
VIMEO_ACCESS_TOKEN=

# Authored calculator markup + config, read by scripts/seed/seed_calculators.py.
CALCULATORS_SOURCE=~/path/to/cmm-frontend/app/lib/calculators
