# Processing image for the webinar video pipeline.
#
# Same source tree as the API image, different base layer: this one carries
# ffmpeg (~150 MB with its codec dependencies). Keeping it separate means the
# API image — pulled on every deploy and every scale-out — does not.
#
# It runs one job and exits; there is no server and no port.

FROM python:3.12-slim AS base

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# ── Dependencies ──────────────────────────────────────────────────────────────
FROM base AS deps

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-cache --no-dev

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM base AS runtime

# ffmpeg (which brings ffprobe) is the whole reason this image exists.
# ca-certificates is needed for the Zoom, Vimeo, S3 and Bedrock calls.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=deps /app/.venv /app/.venv
COPY . .

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Overridden per task by RunTask with the job id appended; this default exists
# so a hand-launched task fails with argparse's usage message rather than
# starting something unexpected.
CMD ["python", "-m", "src.video_pipeline.run_task"]
